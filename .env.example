# 本地配置模板；可选复制为 .env（已被 Git 忽略）。不要提交真实密钥。
# 已设置操作系统用户变量时无需再建 .env；进程环境优先。
# 当前产品默认使用 Qwen，不因 Harness 的项目名称改用 DeepSeek。
# DASHSCOPE_API_KEY=replace_with_your_private_key
HARNESS_API_KEY_ENV=DASHSCOPE_API_KEY
HARNESS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
HARNESS_MODEL=qwen3.8-flash
HARNESS_INPUT_MODALITIES=text,image
