# ==========================================
# 李兆霖数学错题本 Web - 模型配置文件模板
# （复制本文件为 .env 并填入 API Key 即可，.env 已在 .gitignore 中不会提交）
# ==========================================

# 1. DeepSeek 官方通道（默认推荐）
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. 阿里百炼 / 通义千问多模态（如使用百炼请取消注释并填入 Key）
# 将上面的 MODEL_PROVIDER 改为 dashscope
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-vl-max

# 第三阶段只开放 deepseek/dashscope；其他兼容供应商待单独评审后增加 Provider。

# 3. 文件存储（默认本地；生产 OSS 必须显式选择，配置错误时启动失败）
STORAGE_PROVIDER=local

# 生产 OSS 示例：把 STORAGE_PROVIDER 改为 oss，并按部署地域填写以下项目。
# OSS_REGION=cn-beijing
# OSS_BUCKET=your-private-bucket
# OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
# OSS_KEY_PREFIX=math-notebook
# OSS_CREDENTIAL_MODE=ecs_ram_role
# OSS_ECS_ROLE_NAME=your-ecs-ram-role

# 仅限本地联调可改用 OSS_CREDENTIAL_MODE=environment，并在进程环境中设置：
# OSS_ACCESS_KEY_ID、OSS_ACCESS_KEY_SECRET，以及临时凭据需要的 OSS_SESSION_TOKEN。
# 不要把任何真实凭据填写进本文件或提交到 Git。
