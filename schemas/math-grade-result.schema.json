{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lizhaolin.local/schemas/math-grade-result.schema.json",
  "title": "Math grade candidate with complete diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "input_version", "verdict", "first_error", "cause_code", "cause_evidence", "correct_solution", "final_answer", "prevention_cue", "confidence"],
  "properties": {
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "input_version": {"type": "integer", "minimum": 1},
    "verdict": {"enum": ["correct", "partial", "incorrect", "unclear"]},
    "first_error": {"type": ["string", "null"]},
    "cause_code": {"enum": ["knowledge_gap", "concept_confusion", "formula_condition", "method_choice", "reasoning_gap", "algebra_transform", "calculation", "misreading", "incomplete_cases", "expression", "careless", "unclear", null]},
    "cause_evidence": {"type": ["string", "null"]},
    "correct_solution": {"type": ["string", "null"]},
    "final_answer": {"type": ["string", "null"]},
    "prevention_cue": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
